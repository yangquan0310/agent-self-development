{
  "id": "agent-autobiography",
  "name": "Agent Autobiography",
  "version": "4.5.0",
  "description": "OpenClaw plugin for agent self-development based on Piaget's cognitive development theory",
  "main": "src/index.js",
  "type": "native",
  "extensions": ["./src/index.js"],
  "minVersion": "2026.5.0",
  "contracts": {
    "tools": [
      "task.create",
      "task.update",
      "task.advance",
      "task.get",
      "task.archive",
      "event.report",
      "event.query",
      "event.archive"
    ]
  },
  "skills": [
    "./skills/task-management",
    "./skills/event-management"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "archive": {
        "type": "object",
        "description": "任务归档配置",
        "properties": {
          "maxArchivedTasks": { "type": "number", "default": 50, "description": "archive/ 目录保留的最大已完成任务数" }
        }
      }
    }
  }
}
